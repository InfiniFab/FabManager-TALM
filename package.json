            "node-red-contrib-fs": "~1.4.1",
            "node-red-contrib-moment": "~5.0.0",
            "node-red-contrib-timer": "~1.0.6",
            "node-red-contrib-ui-areyousure": "~0.1.0",
            "node-red-contrib-ui-media": "~1.2.0",
            "node-red-contrib-ui-upload": "~0.8.1",
